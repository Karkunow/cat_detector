# Copy this to .env and fill in real values. .env is gitignored.

# From Tapo app -> C200 -> gear icon -> Advanced Settings -> Camera Account
CAMERA_HOST=192.168.1.XXX
CAMERA_USER=
CAMERA_PASS=
ONVIF_PORT=2020

# Optional override; by default main.py builds this from the vars above
# (rtsp://CAMERA_USER:CAMERA_PASS@CAMERA_HOST:554/stream2)
# RTSP_URL=

# From @BotFather (token) and https://api.telegram.org/bot<token>/getUpdates (chat_id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
